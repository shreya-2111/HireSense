# HireSense Backend Environment Configuration

# Application
PROJECT_NAME=HireSense
API_V1_STR=/api/v1
SECRET_KEY=hiresense-super-secret-production-key-change-in-prod-2025
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration (MySQL)
# Example: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hiresense_db

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Uploads Storage Path
UPLOAD_DIR=uploads

# Optional LLM Configuration (e.g. OpenAI / Google Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=none
